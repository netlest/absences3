# Copy to backend/.env and fill in real values. backend/.env is gitignored.
#
# Local development (PostgreSQL on the Unix socket, peer auth as the OS user):
DATABASE_URL=postgresql+psycopg:///kalendarz
#
# Any other host (TCP, password auth):
# DATABASE_URL=postgresql+psycopg://user:password@localhost/dbname
SESSION_TTL_HOURS=48
